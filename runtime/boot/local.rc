#!/bin/sh
# Sourced by OEM startapp. OTA authenticates code; gzip CRC detects corruption.
# Always define the fail-closed media wrapper before attempting any extraction.

# The OEM application enables the speaker amplifier on GPIO 63 and deliberately
# plays camera_alarm.amr for motion events; startup/PTZ movement changes most of
# the frame and is enough to trigger it.
# One early write is not sufficient because jooanipc reasserts the pin.  Mute
# it before jooanipc can start and reclaim it every 20 ms across the complete,
# measured startup-audio window.  Leave it muted afterwards: the containment
# guard, not the OEM application, grants the amplifier only to authenticated
# push-to-talk sessions.
JL_SPEAKER_GPIO=63
JL_SPEAKER_PATH=/sys/class/gpio/gpio$JL_SPEAKER_GPIO
JL_SPEAKER_RUN=/run/jooan-local
JL_SPEAKER_GUARD_READY=$JL_SPEAKER_RUN/speaker-guard-ready
JL_SPEAKER_HOOK_RELEASED=$JL_SPEAKER_RUN/speaker-hook-released
mkdir -p "$JL_SPEAKER_RUN" 2>/dev/null || :
chmod 700 "$JL_SPEAKER_RUN" 2>/dev/null || :
if mkdir "$JL_SPEAKER_RUN/speaker-hook.lock" 2>/dev/null; then
    rm -f "$JL_SPEAKER_GUARD_READY" "$JL_SPEAKER_HOOK_RELEASED"
    if [ ! -d "$JL_SPEAKER_PATH" ]; then
        echo "$JL_SPEAKER_GPIO" > /sys/class/gpio/export 2>/dev/null || :
        jl_speaker_wait=0
        while [ ! -d "$JL_SPEAKER_PATH" ] && [ "$jl_speaker_wait" -lt 20 ]; do
            sleep 0.05
            jl_speaker_wait=$((jl_speaker_wait + 1))
        done
    fi
    if [ -d "$JL_SPEAKER_PATH" ]; then
        echo out > "$JL_SPEAKER_PATH/direction" 2>/dev/null || :
        # This JA-A12 board declares SpeakLevelEx=0: low enables the amplifier
        # and high is the OEM mute level.
        echo 1 > "$JL_SPEAKER_PATH/value" 2>/dev/null || :
    fi
    (
        jl_speaker_tick=0
        while [ -d "$JL_SPEAKER_PATH" ] &&
              [ "$jl_speaker_tick" -lt 3000 ]; do
            echo out > "$JL_SPEAKER_PATH/direction" 2>/dev/null || :
            echo 1 > "$JL_SPEAKER_PATH/value" 2>/dev/null || :
            # Once the pinned containment guard has taken ownership, its
            # interposer enforces mute and can grant authenticated PTT without
            # racing this early-boot hold.
            [ ! -f "$JL_SPEAKER_GUARD_READY" ] || break
            sleep 0.02
            jl_speaker_tick=$((jl_speaker_tick + 1))
        done
        # Keep the OEM muted after the startup race.  The guard temporarily
        # drives this active-low pin low only while it owns an authenticated
        # talkback lease.
        echo out > "$JL_SPEAKER_PATH/direction" 2>/dev/null || :
        echo 1 > "$JL_SPEAKER_PATH/value" 2>/dev/null || :
        printf '%s\n' released > "$JL_SPEAKER_HOOK_RELEASED.new" &&
            chmod 600 "$JL_SPEAKER_HOOK_RELEASED.new" &&
            mv -f "$JL_SPEAKER_HOOK_RELEASED.new" \
                "$JL_SPEAKER_HOOK_RELEASED"
    ) </dev/null >/tmp/jooan-speaker-mute.log 2>&1 &
fi

killall telnetd goahead 2>/dev/null || :
jooanipc() { return 127; }
jl_load_controller() {
    JL_ROOT=/opt/custom/jooan-local
    JL_RUN=/run/jooan-local
    JL_CONTROL=$JL_RUN/controller
    export JL_ROOT JL_RUN JL_CONTROL
    mkdir -p "$JL_RUN" || return 1
    chmod 700 "$JL_RUN" || return 1
    tar -tzf "$JL_ROOT/controller.tar.gz" >/dev/null || return 1
    jl_identity=$(md5sum "$JL_ROOT/controller.tar.gz") || return 1
    jl_identity=${jl_identity%% *}
    if [ -d "$JL_CONTROL" ]; then
        [ "$(cat "$JL_RUN/controller.loaded" 2>/dev/null)" = "$jl_identity" ] || return 1
    else
        [ ! -e "$JL_RUN/controller.new" ] || return 1
        mkdir "$JL_RUN/controller.new" || return 1
        tar -xzf "$JL_ROOT/controller.tar.gz" -C "$JL_RUN/controller.new" || return 1
        [ -r "$JL_RUN/controller.new/boot/common.sh" ] &&
            [ -r "$JL_RUN/controller.new/boot/boot.sh" ] || return 1
        mv "$JL_RUN/controller.new" "$JL_CONTROL" || return 1
        printf '%s\n' "$jl_identity" > "$JL_RUN/controller.loaded" || return 1
    fi
}
if jl_load_controller; then
    # Function lives in the sourcing shell; background boot.sh cannot intercept
    # OEM startapp's later bare `jooanipc &` invocation.
    jooanipc() {
        # jooanipc normally opens its one TLS MQTT session immediately and may
        # not retry after a refused connection. Give the loopback broker time
        # to come up so local password/preset commands remain available. This
        # wait is bounded: media still starts if the optional bridge is sick.
        jl_mqtt_wait=0
        while [ "$jl_mqtt_wait" -lt 30 ]; do
            netstat -lnt 2>/dev/null |
                grep -q '127\.0\.0\.2:1883[[:space:]]' && break
            sleep 1
            jl_mqtt_wait=$((jl_mqtt_wait + 1))
        done
        /bin/sh /run/jooan-local/controller/shared/verify-guard.sh || return 127
        LD_PRELOAD=/run/jooan-local/controller/shared/libjooan_guard.so
        export LD_PRELOAD
        exec /mnt/mtd/run/jooanipc "$@"
    }
    /bin/sh "$JL_CONTROL/boot/boot.sh" </dev/null >/dev/null 2>&1 &
else
    # Even an invalid controller must not revive unauthenticated OEM management.
    (
        while :; do
            killall telnetd goahead 2>/dev/null || :
            sleep 1
        done
    ) </dev/null >/dev/null 2>&1 &
fi
:
