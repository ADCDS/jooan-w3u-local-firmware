set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mipsel)
if(NOT DEFINED ENV{TOOLCHAIN_ROOT})
  message(FATAL_ERROR "Set TOOLCHAIN_ROOT to the Ingenic GCC5.4 multilib toolchain")
endif()
set(CMAKE_C_COMPILER "$ENV{TOOLCHAIN_ROOT}/bin/mips-linux-gnu-gcc")
set(CMAKE_AR "$ENV{TOOLCHAIN_ROOT}/bin/mips-linux-gnu-gcc-ar")
set(CMAKE_RANLIB "$ENV{TOOLCHAIN_ROOT}/bin/mips-linux-gnu-gcc-ranlib")
set(CMAKE_STRIP "$ENV{TOOLCHAIN_ROOT}/bin/mips-linux-gnu-strip")
set(CMAKE_C_FLAGS_INIT "-muclibc -march=mips32r2 -mhard-float -Os")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-muclibc")
